# 5. HELPER FUNCTION FOR AXES PIXEL ASPECT

def axes_pixel_aspect(ax):
    """
    Return width / height of an axes in pixels.
    Used to keep icons circular even in wide axes.
    """

    bbox = ax.get_position()

    fig_w_in, fig_h_in = fig.get_size_inches()
    dpi = fig.dpi

    w_px = bbox.width * fig_w_in * dpi
    h_px = bbox.height * fig_h_in * dpi

    return w_px / h_px


# 6. DRAW ICON FUNCTION

def draw_icon(
    ax,
    kind,
    cx,
    cy,
    r,
    badge_color,
    icon_color="white"
):
    """
    Draw a circular badge with a simple vector icon.
    """

    k = axes_pixel_aspect(ax)

    def X(p):
        """
        Convert logical height-based length
        into x-axis fraction.
        """
        return p / k

    def circ(cx_, cy_, r_, color, z):
        ax.add_patch(
            mpatches.Ellipse(
                (cx_, cy_),
                2 * X(r_),
                2 * r_,
                transform=ax.transAxes,
                facecolor=color,
                linewidth=0,
                zorder=z
            )
        )

    # Main circular badge
    circ(
        cx,
        cy,
        r,
        badge_color,
        5
    )

    s = r * 0.9


    # PEOPLE ICON
    
    if kind == "people":

        circ(
            cx - X(s * 0.28),
            cy + s * 0.15,
            s * 0.28,
            icon_color,
            6
        )

        circ(
            cx + X(s * 0.28),
            cy + s * 0.15,
            s * 0.28,
            icon_color,
            6
        )

        ax.add_patch(
            mpatches.Ellipse(
                (
                    cx - X(s * 0.28),
                    cy - s * 0.35
                ),
                X(s * 0.7) * 2,
                s * 0.55,
                transform=ax.transAxes,
                facecolor=icon_color,
                linewidth=0,
                zorder=6
            )
        )

        ax.add_patch(
            mpatches.Ellipse(
                (
                    cx + X(s * 0.28),
                    cy - s * 0.35
                ),
                X(s * 0.7) * 2,
                s * 0.55,
                transform=ax.transAxes,
                facecolor=icon_color,
                linewidth=0,
                zorder=6
            )
        )


    # CALENDAR ICON
    
    elif kind == "calendar":

        body_w = X(s)
        body_h = s * 0.9

        ax.add_patch(
            mpatches.FancyBboxPatch(
                (
                    cx - body_w * 0.5,
                    cy - body_h * 0.5
                ),
                body_w,
                body_h,
                boxstyle="round,pad=0,rounding_size=0.05",
                transform=ax.transAxes,
                facecolor=icon_color,
                linewidth=0,
                zorder=6
            )
        )

        top_h = s * 0.22

        ax.add_patch(
            mpatches.Rectangle(
                (
                    cx - body_w * 0.5,
                    cy + body_h * 0.5 - top_h
                ),
                body_w,
                top_h,
                transform=ax.transAxes,
                facecolor=badge_color,
                linewidth=0,
                zorder=7
            )
        )

        ring_h = s * 0.18

        for dx in (-s * 0.25, s * 0.25):

            ax.add_patch(
                mpatches.Rectangle(
                    (
                        cx + X(dx) - X(s * 0.03),
                        cy + body_h * 0.5 - top_h * 0.5
                    ),
                    X(s * 0.06),
                    ring_h,
                    transform=ax.transAxes,
                    facecolor=badge_color,
                    linewidth=0,
                    zorder=7
                )
            )


    # MONEY ICON
    
    elif kind == "money":

        bbox = ax.get_position()

        fig_h_in = fig.get_size_inches()[1]

        h_px = bbox.height * fig_h_in * fig.dpi

        ax.text(
            cx,
            cy,
            "$",
            transform=ax.transAxes,
            ha="center",
            va="center",
            fontsize=r * h_px * 0.9,
            fontweight="bold",
            color=icon_color,
            zorder=6
        )


    # STAR ICON
    
    elif kind == "star":

        bbox = ax.get_position()

        fig_h_in = fig.get_size_inches()[1]

        h_px = bbox.height * fig_h_in * fig.dpi

        ax.plot(
            cx,
            cy,
            marker="*",
            markersize=r * h_px * 0.9,
            color=icon_color,
            transform=ax.transAxes,
            zorder=6
        )


