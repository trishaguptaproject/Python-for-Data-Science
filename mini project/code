# 9. CHART CARD STYLE

def style_card(ax, title, accent):

    ax.set_facecolor(CARD_BG)

    # Remove borders
    for spine in ax.spines.values():
        spine.set_visible(False)

    # Remove tick marks
    ax.tick_params(length=0)

    # Remove default title
    ax.set_title("")


    # Colored bullet
    # Moved slightly lower from 1.12 to 1.08
    
    ax.text(
        0.0,
        1.08,
        "\u25CF",
        transform=ax.transAxes,
        fontsize=10,
        color=accent,
        va="center",
        ha="left"
    )


    # Chart title
    # Smaller font and lower position
    
    ax.text(
        0.035,
        1.08,
        title,
        transform=ax.transAxes,
        fontsize=9.5,
        fontweight="bold",
        color=DARK,
        va="center",
        ha="left"
    )


# 10. CARD BACKGROUND

def card_backdrop(ax, pad=0.035):

    bbox = ax.get_position()

    rect = mpatches.FancyBboxPatch(

        (
            bbox.x0 - pad * 0.4,
            bbox.y0 - pad
        ),

        bbox.width + pad * 0.8,

        bbox.height + pad * 1.9,

        boxstyle="round,pad=0,rounding_size=0.015",

        transform=fig.transFigure,

        facecolor=CARD_BG,

        edgecolor="#dfe3e8",

        linewidth=1,

        zorder=0
    )

    fig.patches.append(rect)


