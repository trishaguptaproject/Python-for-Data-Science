#Code:8
#8. Two Plots in One Figure
# Import matplotlib library
import matplotlib.pyplot as plt

# Data
x = [1, 2, 3, 4, 5]
y = [2, 4, 6, 8, 10]

categories = ["A", "B", "C", "D", "E"]
values = [5, 7, 3, 8, 6]

# Create a figure with 2 subplots (1 row, 2 columns)

plt.subplot(1, 2, 1)
plt.plot(x, y)
plt.title("Line Plot")
plt.xlabel("X")
plt.ylabel("Y")

plt.subplot(1, 2, 2)
plt.bar(categories, values)
plt.title("Bar Chart")
plt.xlabel("Category")
plt.ylabel("Value")

# Adjust spacing
plt.tight_layout()

# Display the figure
plt.show()

