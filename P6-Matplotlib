#10. Write a Python program using Matplotlib to visualize sales data:
# You are given the data:
#months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun"]
#sales_2023 = [150, 200, 250, 300, 280, 350]
#sales_2024 = [180, 220, 270, 320, 300, 400]
#Tasks:
#1. Plot two line charts on the same graph:
#2. Add:
#3. Highlight the highest sales month of 2024 by adding an annotation on the graph.
#4. Save the plot as "sales_comparison.png".
# Import matplotlib library
import matplotlib.pyplot as plt

# Data
months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun"]
sales_2023 = [150, 200, 250, 300, 280, 350]
sales_2024 = [180, 220, 270, 320, 300, 400]

# Plot sales for 2023
plt.plot(months, sales_2023,
         color="blue",
         linestyle="--",
         marker="o",
         label="2023")

# Plot sales for 2024
plt.plot(months, sales_2024,
         color="green",
         linestyle="-",
         marker="s",
         label="2024")

# Add title and labels
plt.title("Monthly Sales Comparison (2023 vs 2024)")
plt.xlabel("Months")
plt.ylabel("Sales")

# Add legend
plt.legend()

# Find highest sales in 2024
max_sales = max(sales_2024)
max_index = sales_2024.index(max_sales)

# Add annotation
plt.annotate("Highest Sales",
             xy=(months[max_index], max_sales),
             xytext=(months[max_index], max_sales + 30),
             arrowprops=dict(facecolor="black", arrowstyle="->"))

# Save the figure
plt.savefig("sales_comparison.png")

# Display the graph
plt.show()
