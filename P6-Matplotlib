#9. 4 Subplots (2x2 Grid)
# Import required libraries
import matplotlib.pyplot as plt
import numpy as np

# Data for Line Plot
x = [1, 2, 3, 4, 5]
y = [2, 4, 6, 8, 10]

# Data for Bar Chart
categories = ["A", "B", "C", "D"]
values = [5, 7, 3, 8]

# Data for Scatter Plot
x_scatter = [5, 7, 8, 7, 6, 9, 5]
y_scatter = [99, 86, 87, 88, 100, 86, 103]

# Data for Histogram
data = np.random.normal(size=100)


# Top-Left: Line Plot

plt.subplot(2, 2, 1)
plt.plot(x, y)
plt.title("Line Plot")


# Top-Right: Bar Chart

plt.subplot(2, 2, 2)
plt.bar(categories, values)
plt.title("Bar Chart")


# Bottom-Left: Scatter Plot

plt.subplot(2, 2, 3)
plt.scatter(x_scatter, y_scatter, color="green")
plt.title("Scatter Plot")


# Bottom-Right: Histogram

plt.subplot(2, 2, 4)
plt.hist(data, bins=20)
plt.title("Histogram")

# Adjust spacing
plt.tight_layout()

# Display all plots
plt.show()

