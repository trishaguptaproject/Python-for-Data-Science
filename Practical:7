#Question: Write a Python program using BeautifulSoup to scrape data from the Wikipedia homepage (https://www.wikipedia.org/). 
import requests
from bs4 import BeautifulSoup

print("Name    : Trisha")
print("Roll No : S086")
print("Aim: Scrape data from Wikipedia homepage using BeautifulSoup")
print()

# Step 1: Get Wikipedia Homepage
url = "https://www.wikipedia.org/"

headers = {
    "User-Agent": "Mozilla/5.0"
}

response = requests.get(url, headers=headers)

print("Status Code:", response.status_code)

# Step 2: Parse HTML

soup = BeautifulSoup(response.text, "html.parser")

# 1. Extract first 3 paragraphs

print("\n----- First 3 Paragraphs -----")

paragraphs = soup.find_all("p")

if len(paragraphs) == 0:
    print("No paragraphs found.")
else:
    for i, paragraph in enumerate(paragraphs[:3], start=1):
        print("Paragraph", i, ":", paragraph.get_text(" ", strip=True))

# 2. Find all images and print src URLs

print("\n----- Image URLs -----")

images = soup.find_all("img")

print("Total Images:", len(images))

for i, image in enumerate(images, start=1):
    src = image.get("src")

    if src:
        print("Image", i, ":", src)

# 3. Count total number of links

print("\n----- Total Links -----")

links = soup.find_all("a")

print("Total Number of Links:", len(links))

# 4. Print all headings H1, H2, H3

print("\n----- Headings -----")

headings = soup.find_all(["h1", "h2", "h3"])

for heading in headings:
    text = heading.get_text(" ", strip=True)

    if text:
        print(heading.name.upper(), ":", text)

# 5. Extract all language names
print("\n----- Languages -----")

# Wikipedia language links are contained in elements
# having the class "central-featured-lang"

languages = soup.select(".central-featured-lang")

if languages:
    for language in languages:
        name = language.get_text(" ", strip=True)

        if name:
            print("Language:", name)
else:
    print("No languages found.")

# Practical Completed
print("Practical Completed Successfully")
